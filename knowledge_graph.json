      "behavior": "Math challenge gameplay: instruction view → number boxes + answer buttons + timer bar + correct/wrong/timeout feedback animations. On finish: navigates to ResultScreen (or pops with result map for competition mode)."
    },
    "MindTimerGameScreen": {
      "file": "screens/mind_timer_game_screen.dart",
      "route": "Navigated from ChallengeListScreen or CompetitionDetailScreen",
      "providers_used": ["MindTimerProvider", "PlayerProvider", "ResultProvider"],
      "props": ["challenge (ChallengeDefinition)", "competitionId (String?)"],
      "behavior": "Three per-round states: Ready (target + Start with pulsing animation), Counting (hidden timer + Stop button), Result (actual time, points, accuracy bar, feedback label). Exit confirmation. → ResultScreen."
    },
    "PairHuntGameScreen": {
      "file": "screens/pair_hunt_game_screen.dart",
