    "file": "main.dart",
    "setup": "MultiProvider wrapping MaterialApp",
    "providers_global": [
      "ChangeNotifierProvider(PlayerProvider)",
      "ChangeNotifierProvider(ChallengeProvider)",
      "ChangeNotifierProvider(ResultProvider)",
      "ChangeNotifierProvider(AuthProvider)",
