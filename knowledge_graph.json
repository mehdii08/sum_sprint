      "ChangeNotifierProvider(PairHuntProvider)",
      "ChangeNotifierProvider(TicTacToeProvider)"
    ]
  },
  "challenge_types": {
    "description": "Four challenge types share the Result model. Each has its own Runner (pure logic), Provider (state), GameScreen (UI), and Scoring (points). The ChallengeDefinition model acts as a discriminated union via challengeType field.",
    "types": {
      "math": {
        "runner": "ChallengeRunner",
        "provider": "ChallengeProvider",
        "screen": "GameScreen",
        "scoring": "ScoreCalculator",
        "generator": "QuestionGenerator",
        "flow": "Pre-generate Qs → show Q with 3 options → player taps → record result + advance → after all Qs → compute final score with perfect bonus"
      },
      "mind_timer": {
        "runner": "MindTimerRunner",
        "provider": "MindTimerProvider",
        "screen": "MindTimerGameScreen",
        "scoring": "MindTimerScoring",
        "flow": "Show target time → player taps Start (hidden timer) → player taps Stop → compute accuracy + points → after all rounds → final result"
      },
      "pair_hunt": {
        "runner": "PairHuntRunner",
        "provider": "PairHuntProvider",
        "screen": "PairHuntGameScreen",
        "scoring": "PairHuntScoring",
        "flow": "Generate emoji grid → player flips cards to find matches → countdown timer → match: reveal permanently, mismatch: flip back + penalty → game ends on all pairs found or timeout"
      },
      "tic_tac_toe": {
        "runner": "TicTacToeRunner",
        "provider": "TicTacToeProvider",
        "screen": "TicTacToeGameScreen",
        "scoring": "TicTacToeScoring",
        "ai": "TicTacToeAi (easy/medium/hard minimax)",
        "flow": "3 rounds (easy→medium→hard) → player places X → AI places O after delay → check winner/tie → score per round based on time remaining → final score = average"
      }
    }
  },
  "game_modes": {
    "offline_warm_up": {
      "description": "Local-only play. Results saved via LocalResultRepository (SharedPreferences, max 20 per challenge). No auth required.",
      "data_flow": "Result → LocalResultRepository → SharedPreferences"
    },
    "online_competition": {
      "description": "Auth required. Join competitions, play challenges, submit results to Supabase. Real-time leaderboard via RealtimeChannel.",
      "data_flow": "Auth → join competition → play challenge → submit result → SupabaseCompetitionRepository → update_participant_score RPC → RealtimeChannel triggers leaderboard refresh"
    }
  }
}
