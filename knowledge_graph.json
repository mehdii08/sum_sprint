      "file": "screens/tic_tac_toe_game_screen.dart",
      "route": "Navigated from ChallengeListScreen or CompetitionDetailScreen",
      "providers_used": ["TicTacToeProvider", "PlayerProvider", "ResultProvider"],
      "props": ["challenge (ChallengeDefinition)", "competitionId (String?)"],
      "behavior": "Intro: rounds info, time per round, max points, How to Play. Game: round header (N/3, difficulty chip, score), timer bar, turn indicator, 3x3 board. Round result overlay: win/loss/draw/timeout banner with points. → ResultScreen."
    },
    "ResultScreen": {
      "file": "screens/result_screen.dart",
      "route": "Navigated from any game screen",
      "providers_used": ["ResultProvider", "ChallengeProvider", "MindTimerProvider", "PairHuntProvider", "TicTacToeProvider", "CompetitionProvider"],
      "props": ["result (Result)", "challenge (ChallengeDefinition)", "competitionId (String?)"],
      "behavior": "Final score card with type-specific stats (math: correct/avg time/total time; mind timer: within range/accuracy; pair hunt: pairs/mismatches/time; tic-tac-toe: wins/draws). Competition mode: auto-submits result. High score badge (offline only). Play Again (offline) / Back to Competition buttons."
