{
  "$schema": "https://sum_sprint/knowledge_graph/v1",
  "project": {
    "name": "Sum Sprint",
    "version": "1.0.25",
    "description": "Multi-mode educational math game built with Flutter. Supports offline warm-up practice and online competitions via Supabase.",
    "platforms": ["Android", "iOS", "Web", "macOS", "Linux", "Windows"],
    "repository": "local"
  },
  "architecture": {
    "pattern": "Provider-based state management with repository pattern",
    "data_flow": "Assets/Supabase → Repositories → Providers (ChangeNotifier) → Screens (Consumer/context.watch) → Services (pure logic runners) → Scoring (pure functions) → Models (immutable data)",
    "layers": {
      "ui": "screens/, widgets/",
      "state": "providers/",
      "data": "repositories/",
      "business_logic": "services/",
      "domain": "models/",
      "config": "config/",
      "platform": "platform/",
      "utils": "utils/",
      "i18n": "l10n/"
    }
  },
  "tech_stack": {
    "framework": "Flutter (Dart, SDK ^3.10.0)",
    "state_management": "provider ^6.1.1",
    "local_storage": "shared_preferences ^2.2.2",
    "backend": "Supabase (supabase_flutter ^2.8.1)",
    "auth": "Supabase Auth (email/password + Telegram OAuth via edge function)",
    "i18n": "flutter_localizations + intl ^0.20.2",
    "audio": "audioplayers ^5.2.1",
    "fonts": "google_fonts ^6.1.0"
  },
  "external_integrations": {
    "supabase": {
      "url": "https://xnwjbrtbpjaeuqyrkyvg.supabase.co",
      "tables": ["profiles", "competitions", "participants", "challenge_results", "prizes"],
      "rpc_functions": ["join_competition", "update_participant_score", "distribute_prizes", "get_final_leaderboard"],
      "edge_functions": ["telegram-auth"],
      "features": ["auth", "database", "realtime", "rpc"]
    },
    "telegram": {
      "platform": "Web only",
      "integration": "Reads initData from DOM element #telegram-bridge, posts to Supabase edge function for auth"
    }
  },
  "file_tree": {
    "lib/main.dart": "App entry point, Supabase init, MultiProvider wiring",
    "lib/config/app_version.dart": "AppVersion constants",
    "lib/config/supabase_config.dart": "SupabaseConfig (url, anonKey, admin usernames, debug mode)",
    "lib/l10n/app_en.arb": "English ARB translation file",
    "lib/l10n/app_localizations.dart": "AppLocalizations class with ~150+ translation getters",
    "lib/models/challenge_definition.dart": "ChallengeType enum, ChallengeDefinition class",
    "lib/models/competition.dart": "CompetitionStatus enum, Competition, Participant, LeaderboardEntry classes",
    "lib/models/player_data.dart": "PlayerData class",
    "lib/models/question.dart": "Question, QuestionResult, MindTimerQuestion, MindTimerResult, PairHuntBlock, PairHuntGameResult, TicTacToeMark, TicTacToeDifficulty, TicTacToeRoundOutcome, TicTacToeRoundResult",
    "lib/models/result.dart": "Result class (universal across all challenge types)",
    "lib/services/question_generator.dart": "QuestionGenerator",
    "lib/services/score_calculator.dart": "ScoreCalculator (math scoring)",
    "lib/services/challenge_runner.dart": "ChallengeRunner (math game orchestration)",
    "lib/services/mind_timer_scoring.dart": "MindTimerScoring",
    "lib/services/mind_timer_runner.dart": "MindTimerRunner",
    "lib/services/pair_hunt_scoring.dart": "PairHuntScoring",
    "lib/services/pair_hunt_runner.dart": "PairHuntRunner",
    "lib/services/tic_tac_toe_ai.dart": "TicTacToeBoard, TicTacToeAi (easy/medium/hard/minimax)",
    "lib/services/tic_tac_toe_scoring.dart": "TicTacToeScoring",
    "lib/services/tic_tac_toe_runner.dart": "TicTacToeRunner",
    "lib/repositories/result_repository.dart": "ResultRepository (abstract interface)",
    "lib/repositories/local_result_repository.dart": "LocalResultRepository (SharedPreferences, max 20 results per challenge)",
    "lib/repositories/supabase_competition_repository.dart": "SupabaseCompetitionRepository",
    "lib/repositories/supabase_result_repository.dart": "SupabaseResultRepository",
    "lib/providers/player_provider.dart": "PlayerProvider",
    "lib/providers/auth_provider.dart": "AuthProvider",
    "lib/providers/challenge_provider.dart": "ChallengeProvider (+ GameState enum)",
    "lib/providers/result_provider.dart": "ResultProvider",
    "lib/providers/competition_provider.dart": "CompetitionProvider (+ WinnerNotification class)",
    "lib/providers/mind_timer_provider.dart": "MindTimerProvider (+ MindTimerState enum)",
    "lib/providers/pair_hunt_provider.dart": "PairHuntProvider (+ PairHuntState enum)",
    "lib/providers/tic_tac_toe_provider.dart": "TicTacToeProvider (+ TicTacToeState enum)",
    "lib/screens/splash_screen.dart": "SplashScreen",
    "lib/screens/home_screen.dart": "HomeScreen",
    "lib/screens/login_screen.dart": "LoginScreen",
    "lib/screens/challenge_list_screen.dart": "ChallengeListScreen",
    "lib/screens/game_screen.dart": "GameScreen (math)",
    "lib/screens/mind_timer_game_screen.dart": "MindTimerGameScreen",
    "lib/screens/pair_hunt_game_screen.dart": "PairHuntGameScreen",
    "lib/screens/tic_tac_toe_game_screen.dart": "TicTacToeGameScreen",
    "lib/screens/result_screen.dart": "ResultScreen",
    "lib/screens/history_screen.dart": "HistoryScreen",
    "lib/screens/profile_screen.dart": "ProfileScreen",
    "lib/screens/competitions_screen.dart": "CompetitionsScreen",
    "lib/screens/competition_detail_screen.dart": "CompetitionDetailScreen",
    "lib/screens/admin/admin_dashboard_screen.dart": "AdminDashboardScreen",
    "lib/screens/admin/admin_competitions_screen.dart": "AdminCompetitionsScreen",
    "lib/widgets/answer_button.dart": "AnswerButton",
    "lib/widgets/score_display.dart": "ScoreDisplay",
    "lib/widgets/timer_bar.dart": "TimerBar",
    "lib/platform/telegram_init.dart": "Conditional export for Telegram bridge",
    "lib/platform/telegram_init_io.dart": "Telegram init stub (non-web)",
    "lib/platform/telegram_init_web.dart": "Telegram init web implementation",
    "lib/utils/clear_app_cache.dart": "Conditional export for cache clearing",
    "lib/utils/web_cache_stub.dart": "No-op cache clearer (non-web)",
    "lib/utils/web_cache_web.dart": "Web cache clearing (service workers, Cache Storage, IndexedDB, localStorage)"
  },
  "models": {
    "ChallengeType": {
      "kind": "enum",
      "values": {
        "math": "Arithmetic questions (addition)",
        "mindTimer": "Hidden timer challenge",
        "pairHunt": "Memory card matching game",
        "ticTacToe": "3 rounds vs AI"
      },
      "from_string": "ChallengeType.fromString(String)"
    },
    "ChallengeDefinition": {
      "kind": "class",
      "type": "immutable, const",
      "role": "Defines parameters for a challenge/game session. Union-like discriminator via challengeType.",
      "fields": {
        "id": "String (unique ID)",
        "name": "String (display name)",
        "description": "String",
        "operation": "String (e.g. '+', 'mind_timer', 'pair_hunt', 'tic_tac_toe')",
        "challengeType": "ChallengeType (default: math)",
        "questionCount": "int (default 10, for math/mind_timer)",
        "minNumber": "int (default 1, for math)",
        "maxNumber": "int (default 10, for math)",
        "timePerQuestionSeconds": "int (default 5, for math)",
        "targetSeconds": "double (default 5.0, for mind_timer)",
        "rangeSeconds": "double (default 2.0, for mind_timer tolerance)",
        "maxPoints": "int (default 1000, for mind_timer/tic_tac_toe per round)",
        "blockCount": "int (default 12, always even, for pair_hunt)",
        "timeLimitSeconds": "int (default 60, for pair_hunt game / tic_tac_toe round)",
        "pointsPerPair": "int (default 100, for pair_hunt)",
        "maxTimeBonus": "int (default 500, for pair_hunt early finish)",
        "penaltyPerMismatch": "int (default 25, for pair_hunt wrong attempt)"
      },
      "getters": ["bool isMath", "bool isMindTimer", "bool isPairHunt", "bool isTicTacToe", "int pairCount (blockCount ~/ 2)"],
      "serialization": ["ChallengeDefinition.fromJson(Map)", "toJson() → Map", "static listFromJson(String) → List<ChallengeDefinition>"]
    },
    "CompetitionStatus": {
      "kind": "enum",
      "values": ["upcoming", "active", "finished"],
      "from_string": "CompetitionStatus.fromString(String)"
    },
    "Competition": {
      "kind": "class",
      "role": "Online competition with entry fees, prize pool, and leaderboard",
      "fields": {
        "id": "String",
        "name": "String",
        "description": "String",
        "startDate": "DateTime",
        "endDate": "DateTime",
        "challenges": "List<ChallengeDefinition>",
        "entryPoints": "int (entry fee)",
        "prizePool": "int",
        "winnerCount": "int",
        "winnerShares": "List<double>",
        "status": "CompetitionStatus",
        "createdAt": "DateTime"
      },
      "getters": ["bool hasStarted", "bool hasEnded", "bool isJoinable", "bool isActive", "CompetitionStatus effectiveStatus", "Duration timeRemaining"],
      "serialization": ["Competition.fromJson(Map)"]
    },
    "Participant": {
      "kind": "class",
      "fields": {
        "competitionId": "String",
        "userId": "String",
        "totalScore": "int",
        "completedChallenges": "int",
        "joinedAt": "DateTime"
      },
      "serialization": ["Participant.fromJson(Map)"]
    },
    "LeaderboardEntry": {
      "kind": "class",
      "fields": {
        "userId": "String",
        "nickname": "String",
        "telegramUsername": "String?",
        "totalScore": "int",
        "completedChallenges": "int",
        "rank": "int",
        "prize": "int"
      },
      "serialization": ["LeaderboardEntry.fromJson(Map) — extracts nested profiles data"]
    },
    "PlayerData": {
      "kind": "class",
      "type": "mutable",
      "role": "Local player identity (nickname, uid)",
      "fields": {
        "nickname": "String",
        "uid": "String"
      },
      "serialization": ["fromJson(Map)", "toJson() → Map"]
    },
    "Question": {
      "kind": "class",
      "type": "immutable",
      "role": "Math question with three answer options",
      "fields": {
        "num1": "int",
        "num2": "int",
        "correctAnswer": "int",
        "options": "List<int> (length 3, shuffled)"
      }
    },
    "QuestionResult": {
      "kind": "class",
      "role": "Per-question math result",
      "fields": {
        "isCorrect": "bool",
        "responseTimeMs": "int"
      },
      "serialization": ["toJson()", "fromJson(Map)"]
    },
    "MindTimerQuestion": {
      "kind": "class",
      "role": "Mind timer round parameters",
      "fields": {
        "targetSeconds": "double",
        "rangeSeconds": "double",
        "maxPoints": "int"
      }
    },
    "MindTimerResult": {
      "kind": "class",
      "role": "Per-round mind timer result",
      "fields": {
        "actualSeconds": "double",
        "absoluteDifference": "double",
        "points": "int",
        "accuracy": "double (0.0–1.0)",
        "rangeSeconds": "double"
      },
      "getters": ["bool isWithinRange"]
    },
    "PairHuntBlock": {
      "kind": "class",
      "type": "mutable",
      "role": "A single card in the memory grid",
      "fields": {
        "emoji": "String (65 emoji pool: Animals, Food, Objects, Faces, Nature)",
        "index": "int",
        "isRevealed": "bool (default false)",
        "isMatched": "bool (default false)"
      }
    },
    "PairHuntGameResult": {
      "kind": "class",
      "role": "Final pair hunt game result",
      "fields": {
        "score": "int",
        "pairsFound": "int",
        "totalPairs": "int",
        "mismatchCount": "int",
        "timeTakenSeconds": "double",
        "timeLimitSeconds": "double"
      },
      "getters": ["bool allPairsFound"]
    },
    "TicTacToeMark": {
      "kind": "enum",
      "values": ["none", "player", "ai"]
    },
    "TicTacToeDifficulty": {
      "kind": "enum",
      "type": "string-backed",
      "values": {
        "easy": "Random empty cell",
        "medium": "Win-block-random heuristic",
        "hard": "Minimax with 15% slip chance"
      },
      "from_string": "TicTacToeDifficulty.fromString(String)"
    },
    "TicTacToeRoundOutcome": {
      "kind": "enum",
      "values": ["win", "loss", "draw", "timeout"]
    },
    "TicTacToeRoundResult": {
      "kind": "class",
      "role": "Per-round tic-tac-toe result",
      "fields": {
        "roundNumber": "int",
        "difficulty": "TicTacToeDifficulty",
        "outcome": "TicTacToeRoundOutcome",
        "score": "int",
        "remainingMs": "int",
        "timeLimitMs": "int"
      },
      "getters": ["bool isWin", "bool isDraw", "int elapsedMs"]
    },
    "Result": {
      "kind": "class",
      "role": "Universal persisted game result across all challenge types",
      "fields": {
        "challengeId": "String",
        "score": "int",
        "correctCount": "int",
        "totalResponseTimeMs": "int (total game elapsed ms)",
        "date": "DateTime",
        "playerName": "String",
        "withinRangeCount": "int? (mind timer only)",
        "averageAccuracy": "double? (mind timer only)",
        "isMindTimer": "bool (default false)",
        "isPairHunt": "bool (default false)",
        "pairsFound": "int? (pair hunt only)",
        "totalPairs": "int? (pair hunt only)",
        "mismatchCount": "int? (pair hunt only)",
        "isTicTacToe": "bool (default false)",
        "roundsWon": "int? (tic-tac-toe only)",
        "roundsDrawn": "int? (tic-tac-toe only)",
        "totalRounds": "int? (tic-tac-toe only)"
      },
      "getters": ["double averageTimeSeconds"],
      "serialization": ["fromJson(Map)", "toJson() → Map", "static listFromJson(String) → List<Result>", "static listToJson(List<Result>) → String"]
    }
  },
  "services": {
    "QuestionGenerator": {
      "file": "services/question_generator.dart",
      "role": "Generates random math questions",
      "constructor": "QuestionGenerator({Random? random})",
      "methods": {
        "generate": "Question generate(ChallengeDefinition challenge) — creates question from min/max, computes correctAnswer via operation switch, generates 2 decoys, shuffles 3 options"
      }
    },
    "ScoreCalculator": {
      "file": "services/score_calculator.dart",
      "role": "Math challenge scoring (all static)",
      "methods": {
        "calculateForQuestion": "static int calculateForQuestion(int remainingTimeMs, int totalTimePerQuestionMs) — 100 + remainingSeconds*20, min 10",
        "calculateTotal": "static int calculateTotal(List<QuestionResult> results, int totalTimePerQuestionMs) — sums + 200 perfect bonus"
      }
    },
    "ChallengeRunner": {
      "file": "services/challenge_runner.dart",
      "role": "Orchestrates a math challenge session",
      "dependencies": ["QuestionGenerator"],
      "state_fields": ["_challengeDefinition", "_questions (List<Question>)", "_results (List<QuestionResult>)", "_currentIndex"],
      "getters": ["isActive", "isFinished", "currentIndex", "totalQuestions", "correctCount", "challengeDefinition"],
      "methods": {
        "startChallenge": "void startChallenge(ChallengeDefinition) — pre-generates all questions",
        "getCurrentQuestion": "Question? getCurrentQuestion()",
        "answerSelected": "bool answerSelected(int selectedValue, int elapsedMs) — records result, advances",
        "recordTimeout": "void recordTimeout()",
        "getFinalResult": "Result getFinalResult(PlayerData player) — uses ScoreCalculator"
      }
    },
    "MindTimerScoring": {
      "file": "services/mind_timer_scoring.dart",
      "role": "Mind timer scoring (all static)",
      "methods": {
        "calculate": "static MindTimerResult calculate({actualSeconds, targetSeconds, rangeSeconds, maxPoints}) — accuracy = 1 - diff/range, points = round(maxPoints * accuracy), 0 if out of range",
        "calculateTotal": "static int calculateTotal(List<MindTimerResult>)",
        "feedbackLabel": "static String feedbackLabel(double accuracy) → perfect/amazing/great/close/almost/far/miss"
      }
    },
    "MindTimerRunner": {
      "file": "services/mind_timer_runner.dart",
      "role": "Orchestrates a mind timer session",
      "dependencies": ["MindTimerScoring"],
      "getters": ["isActive", "isFinished", "currentIndex", "totalQuestions", "withinRangeCount", "totalScore", "challengeDefinition"],
      "methods": {
        "startChallenge": "void startChallenge(ChallengeDefinition) — validates isMindTimer",
        "getCurrentQuestion": "MindTimerQuestion? getCurrentQuestion()",
        "recordStop": "MindTimerResult recordStop(double actualSeconds)",
        "getFinalResult": "Result getFinalResult(PlayerData player)"
      }
    },
    "PairHuntScoring": {
      "file": "services/pair_hunt_scoring.dart",
      "role": "Pair hunt scoring (all static)",
      "methods": {
        "calculate": "static PairHuntGameResult calculate({pairsFound, totalPairs, mismatchCount, timeTakenSeconds, timeLimitSeconds, pointsPerPair, maxTimeBonus, penaltyPerMismatch}) — basePoints + timeBonus - penalties, min 0"
      }
    },
    "PairHuntRunner": {
      "file": "services/pair_hunt_runner.dart",
      "role": "Orchestrates a pair hunt (memory game) session",
      "dependencies": ["PairHuntScoring"],
      "has_emoji_pool": "65 distinct emojis across Animals, Food, Objects, Faces, Nature",
      "getters": ["isStarted", "isFinished", "blocks (List<PairHuntBlock>)", "pairsFound", "totalPairs", "mismatchCount", "challengeDefinition", "allPairsFound", "revealedIndices"],
      "methods": {
        "startGame": "void startGame(ChallengeDefinition) — validates isPairHunt, generates grid",
        "canFlip": "bool canFlip(int index)",
        "flipBlock": "void flipBlock(int index)",
        "checkMatch": "bool? checkMatch() — true=match, false=mismatch, null=waiting",
        "markMatch": "void markMatch() — increments pairsFound",
        "resetMismatch": "void resetMismatch() — increments mismatchCount",
        "endByTimeout": "void endByTimeout()",
        "getFinalGameResult": "PairHuntGameResult getFinalGameResult(double timeTakenSeconds)",
        "getFinalResult": "Result getFinalResult(PlayerData player, double timeTakenSeconds)"
      }
    },
    "TicTacToeBoard": {
      "file": "services/tic_tac_toe_ai.dart",
      "role": "Static board utilities for tic-tac-toe",
      "constants": ["cellCount = 9", "winningLines (8 lines of 3 indices)"],
      "methods": {
        "empty": "static List<TicTacToeMark> empty()",
        "availableCells": "static List<int> availableCells(List<TicTacToeMark> board)",
        "isFull": "static bool isFull(List<TicTacToeMark> board)",
        "findWinner": "static TicTacToeMark? findWinner(List<TicTacToeMark> board)",
        "findWinningLine": "static List<int>? findWinningLine(List<TicTacToeMark> board)"
      }
    },
    "TicTacToeAi": {
      "file": "services/tic_tac_toe_ai.dart",
      "role": "AI opponent with 3 difficulty levels",
      "constants": ["hardSlipChance = 0.15"],
      "constructor": "TicTacToeAi({Random? random})",
      "methods": {
        "chooseMove": "int chooseMove(List<TicTacToeMark> board, TicTacToeDifficulty difficulty) — dispatches to _easyMove, _mediumMove, _hardMove",
        "_easyMove": "Random empty cell",
        "_mediumMove": "Win-block-random priority heuristic",
        "_hardMove": "Minimax with 15% slip chance (reverts to random)"
      }
    },
    "TicTacToeScoring": {
      "file": "services/tic_tac_toe_scoring.dart",
      "role": "Tic-tac-toe scoring (all static)",
      "methods": {
        "calculateRoundScore": "static int calculateRoundScore({outcome, remainingMs, timeLimitMs, maxPoints}) — win: round(maxPoints * remainingMs/timeLimitMs), min 10% of maxPoints. Loss/draw/timeout: 0",
        "calculateFinalScore": "static int calculateFinalScore(List<TicTacToeRoundResult>) — average of round scores"
      }
    },
    "TicTacToeRunner": {
      "file": "services/tic_tac_toe_runner.dart",
      "role": "Orchestrates a 3-round tic-tac-toe session",
      "dependencies": ["TicTacToeAi", "TicTacToeScoring", "TicTacToeBoard"],
      "constants": ["roundsPerChallenge = 3", "roundDifficulties = [easy, medium, hard]"],
      "getters": ["challengeDefinition", "board (List<TicTacToeMark>)", "results (unmodifiable List<TicTacToeRoundResult>)", "currentRoundNumber", "currentDifficulty", "isFinished", "roundsWon", "roundsDrawn", "finalScore", "totalRoundScore", "winningLine"],
      "methods": {
        "startChallenge": "void startChallenge(ChallengeDefinition) — validates isTicTacToe",
        "startRound": "void startRound()",
        "canPlaceAt": "bool canPlaceAt(int index)",
        "placePlayerMark": "void placePlayerMark(int index)",
        "placeAiMark": "int placeAiMark() — returns chosen cell index",
        "findWinner": "TicTacToeMark? findWinner()",
        "isBoardFull": "bool get isBoardFull",
        "recordRoundResult": "TicTacToeRoundResult recordRoundResult({outcome, remainingMs})",
        "getFinalResult": "Result getFinalResult(PlayerData player)"
      }
    }
  },
  "repositories": {
    "ResultRepository": {
      "file": "repositories/result_repository.dart",
      "kind": "abstract class (interface)",
      "methods": {
        "getResultsForChallenge": "Future<List<Result>> getResultsForChallenge(String challengeId)",
        "saveResult": "Future<void> saveResult(Result result)",
        "getHighScore": "Future<int> getHighScore(String challengeId)",
        "clearHistory": "Future<void> clearHistory(String challengeId)"
      }
    },
    "LocalResultRepository": {
      "file": "repositories/local_result_repository.dart",
      "implements": "ResultRepository",
      "storage": "SharedPreferences, key prefix 'results_', max 20 results per challenge",
      "methods": {
        "getResultsForChallenge": "Future<List<Result>> — sorted newest first, deserialized from JSON",
        "saveResult": "Future<void> — inserts, trims to max 20",
        "getHighScore": "Future<int> — max score from stored results",
        "clearHistory": "Future<void>"
      }
    },
    "SupabaseCompetitionRepository": {
      "file": "repositories/supabase_competition_repository.dart",
      "role": "All competition-related Supabase operations",
      "constructor": "SupabaseCompetitionRepository({SupabaseClient? client})",
      "getters": ["String? get currentUserId"],
      "methods": {
        "getCompetitions": "Future<List<Competition>>",
        "getCompetition": "Future<Competition?> getCompetition(String id)",
        "hasJoined": "Future<bool> hasJoined(String competitionId)",
        "joinCompetition": "Future<void> joinCompetition(String competitionId) — calls join_competition RPC",
        "getMyParticipation": "Future<Participant?> getMyParticipation(String competitionId)",
        "getLeaderboard": "Future<List<LeaderboardEntry>> getLeaderboard(String competitionId, {int limit=20}) — joins participants + profiles",
        "getCompletedChallengeIds": "Future<Set<String>> getCompletedChallengeIds(String competitionId)",
        "finalizeCompetition": "Future<List<Map<String, dynamic>>?> finalizeCompetition(String) — calls distribute_prizes RPC",
        "getFinalLeaderboard": "Future<List<LeaderboardEntry>> getFinalLeaderboard(String, {int limit=20}) — calls get_final_leaderboard RPC",
        "submitChallengeResult": "Future<void> submitChallengeResult({competitionId, result}) — inserts challenge_results + calls update_participant_score RPC"
      }
    },
    "SupabaseResultRepository": {
      "file": "repositories/supabase_result_repository.dart",
      "implements": "ResultRepository",
      "methods": {
        "getResultsForChallenge": "Future<List<Result>> — from challenge_results table",
        "saveResult": "Future<void> — inserts to challenge_results",
        "saveCompetitionResult": "Future<void> saveCompetitionResult({competitionId, result}) — inserts + calls update_participant_score RPC",
        "getHighScore": "Future<int> — max score from challenge_results",
        "clearHistory": "Future<void> — deletes from challenge_results by user_id + challenge_id"
      }
    }
  },
  "providers": {
    "PlayerProvider": {
      "file": "providers/player_provider.dart",
      "extends": "ChangeNotifier",
      "grain": "Global (shared across all screens)",
      "state": {
        "playerData": "PlayerData (nickname, uid)"
      },
      "getters": ["playerData", "nickname", "uid", "hasUid"],
      "methods": {
        "setNickname": "Future<void> setNickname(String) — persists to SharedPreferences",
        "setUid": "void setUid(String uid)",
